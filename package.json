{
  "name": "elderberrie-video",
  "version": "1.0.0",
  "description": "My Remotion video",
  "repository": {},
  "license": "UNLICENSED",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24"
  },
  "private": true,
  "dependencies": {
    "@remotion/cli": "4.0.537",
    "@remotion/zod-types": "4.0.537",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "remotion": "4.0.537",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@remotion/eslint-config-flat": "4.0.537",
    "@types/react": "19.2.7",
    "@types/web": "0.0.166",
    "eslint": "10.12.0",
    "prettier": "3.8.1",
    "typescript": "5.9.3"
  },
  "scripts": {
    "dev": "remotion studio",
    "build": "remotion bundle",
    "upgrade": "remotion upgrade",
    "lint": "eslint src && tsc",
    "render:reel": "remotion render Reel out/reel.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac",
    "render:feed": "remotion render Feed out/feed.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac",
    "render:square": "remotion render Square out/square.mp4 --codec=h264 --pixel-format=yuv420p --audio-codec=aac",
    "render:social": "npm run render:reel && npm run render:feed && npm run render:square"
  },
  "allowScripts": {
    "esbuild": false
  }
}
